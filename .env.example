# ─────────────────────────────────────────────────────────────────────────────
# CSA site + PrintQ configuration. Copy to `.env` (docker compose) or `.env.local`
# (npm run dev). Never commit the copy.
#
# Quick start (demo mode, no Discord needed): fill in the two secrets marked
# REQUIRED below, leave everything else as is, then `docker compose up --build`.
#
# What is NOT in this file: anything staff change while PrintQ runs lives in
# Postgres and is edited on the website (Staff → Settings / Schedule) or from
# Discord (/printstaff, the staff board): lab hours, closures, booking rules
# (hold time, max print length, quotas…), which i3 variant the printer is, who
# is staff/admin, bans, and all bookings. This file only holds secrets,
# Discord IDs and switches.
# ─────────────────────────────────────────────────────────────────────────────

# ── Containers (docker-compose.yml only) ─────────────────────────────────────
# Postgres password for the bundled database. Compose builds DATABASE_URL from it.
POSTGRES_PASSWORD=printq
# Host ports. Keep WEB_PORT in step with SITE_DOMAIN below.
WEB_PORT=3000
POSTGRES_PORT=5432

# ── Site ─────────────────────────────────────────────────────────────────────
# Host (and port) people use to reach the site, without https://.
# localhost:3000 for testing; csa.ufv.ca in production. Used for links, the
# Discord OAuth redirect and cookies.
SITE_DOMAIN=localhost:3000

# Sanity CMS (announcements, events, executives…). The project ID and dataset
# are public (they're in the live site's page source / sanity.io/manage).
# With the placeholder, PrintQ works but the CMS pages show errors.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.
NEXT_PUBLIC_SANITY_PROJECT_ID=dummy000
NEXT_PUBLIC_SANITY_DATASET=production
# Write token (sanity.io/manage → API → Tokens). The site refuses to load some
# routes without a value, so keep the placeholder if you have no Sanity access.
SANITY_API_WRITE_TOKEN=placeholder-no-sanity
SANITY_WEBHOOK_MESSAGE_SECRET=
NEXT_PUBLIC_UMAMI_ANALYTICS_SITE_ID=
# Bearer tokens for the site's own scheduled endpoints (event reminders, UFV news).
AUTH_TOKEN_EVENT_REMINDERS=
AUTH_TOKEN_UFV_NEWS=

# ── Discord application (the existing CSA app; Developer Portal) ─────────────
# General Information → Application ID. Also the OAuth client ID.
DISCORD_BOT_ID=
# General Information → Public Key (verifies /sccroom, /print, button clicks).
DISCORD_PUBLIC_KEY=
# Bot → Token.
DISCORD_BOT_TOKEN=
# OAuth2 → Client Secret (PrintQ "Continue with Discord").
# Add the redirect: http://localhost:3000/api/printq/auth/callback/discord
# (and https://csa.ufv.ca/api/printq/auth/callback/discord in production).
DISCORD_CLIENT_SECRET=
# Interactions Endpoint URL (General Information) must be a public HTTPS URL:
# https://<SITE_DOMAIN>/api/webhooks/discord/interact. Locally, use a tunnel
# (e.g. cloudflared) or test buttons in the in-browser preview (demo mode).

# ── Discord server (right-click → Copy ID, with Developer Mode on) ───────────
DISCORD_SERVER_ID=
DISCORD_SERVER_INVITE_LINK=
# Existing site features
DISCORD_ANNOUNCEMENT_CHANNEL_ID_CSA=
DISCORD_ANNOUNCEMENT_CHANNEL_ID_IEEE=
DISCORD_EVENT_CHANNEL_ID=
DISCORD_EVENT_REMINDER_CHANNEL_ID=
DISCORD_UFV_NEWS_CHANNEL_ID=
# /sccroom: the room status channel and the role allowed to toggle it.
# The PrintQ board's Open/Close lab button does the same thing.
DISCORD_SCC_ROOM_CHANNEL_ID=
DISCORD_SCC_ROOM_ROLE_ID=

# ── PrintQ ───────────────────────────────────────────────────────────────────
# Turns PrintQ on (routes 404 and the nav link hides when false). Build-time.
NEXT_PUBLIC_PRINTQ_ENABLED=true

# Demo mode: one-click demo accounts on the sign-in page, demo bookings, every
# Discord message goes to an in-app outbox and a clickable Discord preview
# (Staff → Discord) instead of Discord. The Discord values above become optional.
# Set to false for a real test against your Discord server. Never true in production.
PRINTQ_DEMO=true

# REQUIRED. Session signing key, 32+ characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# REQUIRED. Protects the scheduled-jobs endpoint, 32+ characters: `openssl rand -hex 32`
PRINTQ_CRON_SECRET=

# Postgres. docker compose sets this itself (from POSTGRES_PASSWORD); this value
# is for `npm run dev` against a local database.
DATABASE_URL=postgres://printq:printq@localhost:5432/printq
# Where uploaded G-code is stored. docker compose uses a volume at /data/uploads.
PRINTQ_UPLOAD_DIR=./.printq-uploads

# Members need this Discord role to book (e.g. "Verified").
PRINTQ_VERIFIED_ROLE_ID=
# Members with this role are PrintQ staff, on the website and in Discord
# (approve, run prints, closures). Optional: staff can also be promoted in PrintQ.
PRINTQ_STAFF_ROLE_ID=
# Comma-separated Discord user IDs made PrintQ admins on sign-in (lab hours,
# settings, printer model). Put your own ID here.
PRINTQ_ADMIN_DISCORD_IDS=
# Private staff channel: request cards and the pinned staff board.
PRINTQ_ADMIN_CHANNEL_ID=
# Optional members' channel for the anonymous "this week" board.
PRINTQ_PUBLIC_CHANNEL_ID=
# Printer variant used when the database is first set up (MK3S, MK3, MK2.5S,
# MK2.5, MK2S, MK3.5, MK4S). Change it later in Staff → Settings → Printer.
PRINTQ_PRINTER_MODEL=MK3S

# Copy to .env.local for development. Names only: never commit real values.

# --- Existing site ---
SITE_DOMAIN=localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
SANITY_WEBHOOK_MESSAGE_SECRET=
NEXT_PUBLIC_UMAMI_ANALYTICS_SITE_ID=
AUTH_TOKEN_EVENT_REMINDERS=
AUTH_TOKEN_UFV_NEWS=
DISCORD_BOT_ID=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_SERVER_ID=
DISCORD_SERVER_INVITE_LINK=
DISCORD_ANNOUNCEMENT_CHANNEL_ID_CSA=
DISCORD_ANNOUNCEMENT_CHANNEL_ID_IEEE=
DISCORD_EVENT_CHANNEL_ID=
DISCORD_EVENT_REMINDER_CHANNEL_ID=
DISCORD_SCC_ROOM_CHANNEL_ID=
DISCORD_SCC_ROOM_ROLE_ID=
DISCORD_UFV_NEWS_CHANNEL_ID=

# --- PrintQ ---
# Feature flag: routes 404 and the nav link is hidden unless "true".
NEXT_PUBLIC_PRINTQ_ENABLED=false
DATABASE_URL=postgres://printq:printq@localhost:5432/printq
# Demo/prototype mode: one-click demo accounts on the sign-in page, everyone counts
# as a verified member, Discord messages go to the in-app outbox only, simulated
# printer telemetry, and staff can open/close the lab from the dashboard.
# The Discord variables below become optional. Never enable on the live site.
PRINTQ_DEMO=false
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# OAuth2 client secret of the existing CSA Discord app (Developer Portal → OAuth2).
# Redirect URI to register there: https://<SITE_DOMAIN>/api/printq/auth/callback/discord
# With DISCORD_BOT_ID + DISCORD_CLIENT_SECRET set, "Continue with Discord" appears (also in demo mode).
DISCORD_CLIENT_SECRET=
PRINTQ_VERIFIED_ROLE_ID=
# Optional: members with this Discord role are PrintQ staff (on the website and in Discord).
PRINTQ_STAFF_ROLE_ID=
# Private staff channel: request cards and the pinned board go here.
PRINTQ_ADMIN_CHANNEL_ID=
# Optional members' channel for the anonymous "this week" board.
PRINTQ_PUBLIC_CHANNEL_ID=
# Comma-separated Discord user IDs promoted to admin on sign-in.
PRINTQ_ADMIN_DISCORD_IDS=
# openssl rand -hex 32
PRINTQ_CRON_SECRET=
PRINTQ_UPLOAD_DIR=/var/lib/printq/uploads
